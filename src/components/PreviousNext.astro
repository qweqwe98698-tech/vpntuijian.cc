---
/** 上一篇 / 下一篇导航 */
interface Props {
  prev?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="prev-next" aria-label="上一篇与下一篇">
    {prev ? (
      <a class="pn-link" href={prev.href} rel="prev">
        <span class="pn-label">上一篇</span>
        <span class="pn-title">{prev.title}</span>
      </a>
    ) : (
      <span></span>
    )}
    {next && (
      <a class="pn-link pn-next" href={next.href} rel="next">
        <span class="pn-label">下一篇</span>
        <span class="pn-title">{next.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }
  @media (max-width: 600px) {
    .prev-next {
      grid-template-columns: 1fr;
    }
  }
  .pn-link {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .pn-link:hover {
    border-color: var(--color-brand);
    text-decoration: none;
  }
  .pn-next {
    text-align: right;
  }
  .pn-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .pn-title {
    font-weight: 600;
    color: var(--color-heading);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .pn-link:hover .pn-title {
    color: var(--color-brand);
  }
</style>

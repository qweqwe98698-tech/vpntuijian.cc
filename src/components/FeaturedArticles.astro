---
/** 精选文章 */
import type { ArticleCard as Card } from '@lib/content';
import ArticleCard from './ArticleCard.astro';

interface Props {
  items: Card[];
  title?: string;
  lead?: string | undefined;
  alt?: boolean;
}

const { items, title = '精选内容', lead, alt = false } = Astro.props;
---

{items.length > 0 && (
  <section class={`section ${alt ? 'section-alt' : ''}`} aria-label={title}>
    <div class="container">
      <h2 class="section-title">{title}</h2>
      {lead && <p class="section-lead">{lead}</p>}
      <div class="grid grid-3">
        {items.map((item) => (
          <ArticleCard
            title={item.title}
            description={item.description}
            href={item.href}
            category={item.category}
            updatedAt={item.updatedAt}
          />
        ))}
      </div>
    </div>
  </section>
)}

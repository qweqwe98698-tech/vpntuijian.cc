---
/**
 * 合作推荐位:首页与机场推荐 Hub 上的固定曝光区块。
 *
 * 这是商业推广位,不是评测结论。区块标题、徽章和说明文字都必须让读者
 * 一眼看出这一点 —— 把推广位伪装成编辑推荐是本站明确反对的做法。
 */
import type { CollectionEntry } from 'astro:content';
import DataStatusBadge from './DataStatusBadge.astro';

interface Props {
  providers: CollectionEntry<'providers'>[];
  alt?: boolean;
  bare?: boolean;
}

const { providers, alt = false, bare = false } = Astro.props;

const promoted = providers
  .filter((p) => p.data.promotedRank !== undefined && !p.data.draft && !p.data.noindex)
  .sort((a, b) => (a.data.promotedRank ?? 0) - (b.data.promotedRank ?? 0));

function entryPrice(p: CollectionEntry<'providers'>): string {
  const monthly = p.data.pricing.filter((x) => x.price.includes('/ 月'));
  const pool = monthly.length > 0 ? monthly : p.data.pricing;
  if (pool.length === 0) return '—';
  const parsed = pool
    .map((x) => ({ raw: x.price, num: Number.parseFloat(x.price.replace(/[^\d.]/g, '')) }))
    .filter((x) => Number.isFinite(x.num))
    .sort((a, b) => a.num - b.num);
  return parsed[0]?.raw ?? pool[0]!.price;
}
---

{promoted.length > 0 && (
  <section class={`section ${alt ? 'section-alt' : ''}`} aria-labelledby="promoted-title">
    <div class={bare ? '' : 'container'}>
      <h2 class="section-title" id="promoted-title">合作推荐</h2>
      <p class="section-lead">
        以下服务与本站存在推广合作。<strong>这是商业推广位,不是测评排名</strong>——
        它们未必比<a href="/directory/">服务导航</a>里的其他服务更快或更稳定。
        信息整理自官方页面,本站尚未独立实测,选择前请按<a href="/airport/">判断标准</a>自行核对。
      </p>

      <ol class="promo-list">
        {promoted.map((p) => (
          <li class="promo-item">
            <div class="promo-head">
              <h3><a href={`/directory/${p.id}/`}>{p.data.name}</a></h3>
              <DataStatusBadge status={p.data.dataStatus} />
            </div>
            {p.data.positioning && <p class="promo-pos">{p.data.positioning}</p>}
            <dl class="promo-meta">
              <dt>起步价</dt>
              <dd>{entryPrice(p)}</dd>
              {p.data.lineTypes.length > 0 && (
                <>
                  <dt>线路</dt>
                  <dd>{p.data.lineTypes.join('、')}</dd>
                </>
              )}
              {p.data.coupon && (
                <>
                  <dt>优惠码</dt>
                  <dd><code>{p.data.coupon.code}</code>({p.data.coupon.name})</dd>
                </>
              )}
            </dl>
            <div class="promo-actions">
              <a class="btn btn-secondary" href={`/directory/${p.id}/`}>看档案</a>
              {p.data.affiliateUrl && (
                <a
                  class="btn btn-primary"
                  href={p.data.affiliateUrl}
                  rel="nofollow sponsored noopener"
                  target="_blank"
                >前往官网</a>
              )}
            </div>
          </li>
        ))}
      </ol>

      <p class="promo-foot">
        通过上述链接完成购买时,本站可能获得佣金,不会增加你的费用。推广关系不改变档案中记录的限制与风险提示,完整规则见<a href="/disclosure/">推广披露</a>。
      </p>
    </div>
  </section>
)}

<style>
  .promo-list {
    list-style: none;
    counter-reset: promo;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .promo-item {
    counter-increment: promo;
    position: relative;
    border: 1px solid var(--color-brand);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
  }
  .promo-item::before {
    content: counter(promo);
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: var(--space-4);
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-brand);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .promo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .promo-head h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .promo-pos {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }
  .promo-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .promo-meta dt {
    font-weight: 600;
    color: var(--color-heading);
    white-space: nowrap;
  }
  .promo-meta dd {
    margin: 0;
  }
  .promo-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .promo-foot {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin: 0;
  }
</style>

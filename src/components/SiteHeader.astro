---
/** 全站页眉 */
import { SITE } from '@lib/site';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
import SearchButton from './SearchButton.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name}首页`}>
      <svg class="brand-mark" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 4 6v6c0 4.6 3.4 8.4 8 10 4.6-1.6 8-5.4 8-10V6l-8-4Z" />
        <path d="m9 12 2 2 4-4" />
      </svg>
      <span class="brand-name">{SITE.name}</span>
    </a>
    <DesktopNavigation currentPath={currentPath} />
    <div class="header-actions">
      <SearchButton />
      <ThemeToggle />
      <MobileNavigation currentPath={currentPath} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--color-brand);
  }
  .brand-mark {
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
</style>

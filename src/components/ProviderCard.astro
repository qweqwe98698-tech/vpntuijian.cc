---
/**
 * 服务档案卡片(服务导航列表用)。
 *
 * 结构说明:整卡不能用 <a> 包裹 —— 卡片内还有一个注册按钮,嵌套 <a> 是非法 HTML。
 * 改用「标题链接以 ::after 铺满卡片」的模式:点卡片任意位置进档案页,
 * 注册按钮通过 z-index 浮在上层单独可点,两个链接都可键盘聚焦。
 */
import type { CollectionEntry } from 'astro:content';
import DataStatusBadge from './DataStatusBadge.astro';
import ProviderStatus from './ProviderStatus.astro';

interface Props {
  provider: CollectionEntry<'providers'>;
}

const { provider } = Astro.props;
const d = provider.data;

/** 取最低月付档作为起步价。卡片上必须有价格,否则「免费注册」会被误读成服务免费。 */
function entryPrice(): string | null {
  const monthly = d.pricing.filter((x) => x.price.includes('/ 月'));
  const pool = monthly.length > 0 ? monthly : d.pricing;
  if (pool.length === 0) return null;
  const parsed = pool
    .map((x) => ({ raw: x.price, num: Number.parseFloat(x.price.replace(/[^\d.]/g, '')) }))
    .filter((x) => Number.isFinite(x.num))
    .sort((a, b) => a.num - b.num);
  return parsed[0]?.raw ?? pool[0]!.price;
}

const price = entryPrice();
---

<div class="card provider-card">
  <div class="pc-head">
    <h3>
      <a class="pc-link" href={`/directory/${provider.id}/`}>{d.name}</a>
    </h3>
    <ProviderStatus status={d.status} />
  </div>

  <p class="pc-summary">{d.summary}</p>

  <div class="pc-tags">
    {d.promotedRank !== undefined && (
      <span class="badge badge-promo" title="与本站存在推广合作,因此排在前面。这不是测评结论。">合作推荐</span>
    )}
    <DataStatusBadge status={d.dataStatus} />
    {d.lineTypes.slice(0, 3).map((t) => <span class="badge">{t}</span>)}
    {d.nodeRegions.length > 0 && <span class="badge">{d.nodeRegions.length} 个地区</span>}
  </div>

  <div class="pc-foot">
    {price && (
      <span class="pc-price">
        <span class="pc-price-label">最低套餐</span>
        <strong>{price}</strong>
      </span>
    )}
    {d.affiliateUrl && (
      <a
        class="btn btn-primary pc-cta"
        href={d.affiliateUrl}
        rel="nofollow sponsored noopener"
        target="_blank"
      >
        免费注册
      </a>
    )}
  </div>
</div>

<style>
  .provider-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .provider-card:hover {
    border-color: var(--color-brand);
    box-shadow: var(--shadow);
  }
  .pc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .pc-head h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  /* 标题链接铺满整卡:点卡片任意空白处进档案页 */
  .pc-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .pc-summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-3);
  }
  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .pc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .pc-price {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .pc-price-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .pc-price strong {
    color: var(--color-heading);
  }
  /* 浮在铺满层之上,使其可单独点击 */
  .pc-cta {
    position: relative;
    z-index: 1;
    padding: 0.45rem 1.1rem;
    font-size: var(--text-sm);
    margin-left: auto;
  }
</style>

---
/** 文章卡片(列表通用) */
import { formatDate } from '@lib/site';

interface Props {
  title: string;
  description: string;
  href: string;
  category?: string | undefined;
  updatedAt?: Date | undefined;
}

const { title, description, href, category, updatedAt } = Astro.props;
---

<a class="card article-card" href={href}>
  <div class="card-meta">
    {category && <span class="badge">{category}</span>}
    {updatedAt && <span class="card-date">更新于 {formatDate(updatedAt)}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .card-date {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>

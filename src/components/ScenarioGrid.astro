---
/** 按使用场景选择 */
interface Props {
  items: { title: string; description: string; href: string }[];
  title?: string;
  lead?: string;
}

const { items, title = '按使用场景选择', lead = '不同用途对节点和线路的要求不一样,先想清楚主要用来做什么。' } = Astro.props;
---

<section class="section section-alt" aria-labelledby="scenario-title">
  <div class="container">
    <h2 class="section-title" id="scenario-title">{title}</h2>
    <p class="section-lead">{lead}</p>
    <div class="grid grid-3">
      {items.map((item) => (
        <a class="card" href={item.href}>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

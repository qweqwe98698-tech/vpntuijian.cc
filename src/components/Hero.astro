---
/** 首页品牌首屏 */
import { SITE } from '@lib/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="hero">
  <div class="container">
    <p class="hero-tagline">{SITE.tagline}</p>
    <h1>{title}</h1>
    <p class="hero-lead">
      这里不排「最强机场榜单」。我们把选择参考、客户端配置、订阅管理和故障排查整理成可以照着做的知识库,帮你在选择、使用和出问题的每个环节都有据可依。
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/choose/">开始选择</a>
      <a class="btn btn-secondary" href="/troubleshooting/">查找故障</a>
      <a class="btn btn-secondary" href="/clients/">客户端教程</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-10) 0 var(--space-8);
    background: linear-gradient(180deg, var(--color-brand-soft), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }
  .hero-tagline {
    color: var(--color-brand);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    max-width: 24em;
    margin-bottom: var(--space-4);
  }
  .hero-lead {
    max-width: 42em;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>

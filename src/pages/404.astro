---
import BaseLayout from '@layouts/BaseLayout.astro';
import { primaryNav } from '@lib/site';
---

<BaseLayout
  title="页面不存在（404）｜VPN推荐指南"
  description="你访问的页面不存在或已被移动。可以使用站内搜索或从栏目导航找到需要的内容。"
  path="/404/"
  noindex={true}
>
  <div class="container">
    <div class="nf">
      <p class="nf-code">404</p>
      <h1>这个页面不存在</h1>
      <p class="nf-lead">
        链接可能已失效,或页面已被移动。试试站内搜索,或从下面的栏目重新出发。
      </p>
      <div class="nf-actions">
        <a class="btn btn-primary" href="/">返回首页</a>
        <a class="btn btn-secondary" href="/search/">站内搜索</a>
      </div>
      <div class="grid grid-3 nf-grid">
        {primaryNav.slice(0, 6).map((item) => (
          <a class="card" href={item.href}>
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    padding: var(--space-10) 0;
    text-align: center;
  }
  .nf-code {
    font-size: 5rem;
    font-weight: 800;
    color: var(--color-brand);
    line-height: 1;
    margin-bottom: var(--space-3);
  }
  .nf-lead {
    color: var(--color-muted);
    max-width: 36rem;
    margin: 0 auto var(--space-5);
  }
  .nf-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .nf-grid {
    text-align: left;
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import QuickProblemFinder from '@components/QuickProblemFinder.astro';
import ScenarioGrid from '@components/ScenarioGrid.astro';
import TroubleshootingGrid from '@components/TroubleshootingGrid.astro';
import ClientGuideGrid from '@components/ClientGuideGrid.astro';
import FeaturedArticles from '@components/FeaturedArticles.astro';
import LatestUpdates from '@components/LatestUpdates.astro';
import MethodologyPreview from '@components/MethodologyPreview.astro';
import RiskAlerts from '@components/RiskAlerts.astro';
import NewsletterPlaceholder from '@components/NewsletterPlaceholder.astro';
import PicksGrid from '@components/PicksGrid.astro';
import PromotedProviders from '@components/PromotedProviders.astro';
import FAQSection from '@components/FAQSection.astro';
import { getCollection } from 'astro:content';
import { getAllCards, getPublished, toCard } from '@lib/content';
import { organizationSchema, websiteSchema, faqSchema } from '@lib/schema';

const all = await getAllCards();
const pickEntries = await getPublished('picks');
const providerEntries = await getCollection('providers');
const latest = all.slice(0, 8);
const troubleshootingCards = (await getPublished('troubleshooting')).map(toCard).slice(0, 4);
const clientCards = (await getPublished('clients')).map(toCard).slice(0, 4);
const chooseCards = (await getPublished('articles'))
  .map(toCard)
  .filter((c) => c.category === '选择指南')
  .slice(0, 3);

const scenarioItems = [
  {
    title: 'AI 工具',
    description: 'ChatGPT、Claude 等服务的节点选择与断流处理。',
    href: '/scenarios/ai-tools-node-selection/',
  },
  {
    title: '流媒体',
    description: 'Netflix 等平台的解锁判断与地区选择方法。',
    href: '/scenarios/streaming-node-guide/',
  },
  {
    title: '远程办公',
    description: '视频会议与办公工具对稳定性的要求和配置建议。',
    href: '/scenarios/remote-work-proxy-guide/',
  },
];

// 首页 FAQ 承接 P0 核心决策问题(问题库第 49 节),同时输出 FAQPage 结构化数据
const faq = [
  {
    q: '2026 年机场应该怎么选?',
    a: '先确定用途和预算,再按四个维度筛:线路类型决定高峰期体验,流量与设备政策决定够不够用,付费周期决定风险敞口,运营透明度决定跑路概率。第一次买只买最低档月付,用满一个月再决定是否续长期,这一步能避开大部分损失。',
  },
  {
    q: '稳定机场推荐应该看哪些指标?',
    a: '「稳定」要拆成可验证的指标:晚高峰的延迟劣化幅度、丢包率、长连接是否频繁中断、出口 IP 是否频繁变化、故障后的修复速度。节点数量多、延迟数字低都不等于稳定,连续几天在你自己的网络环境下实测才有参考价值。',
  },
  {
    q: '便宜机场和专线机场有什么区别?',
    a: '低价机场通常走普通中转或直连,带宽共享程度高,晚高峰劣化明显;IEPL、IPLC 专线不与公网流量混跑,高峰期波动小,但价格通常高数倍且倍率更高。日常网页和文字类工作用低价档就够,视频会议和实时性要求高的场景才值得为专线付溢价。',
  },
  {
    q: '新手第一次购买机场应该注意什么?',
    a: '只买最低档月付,不要被年付折扣吸引;确认支持你的设备和客户端;看清退款条款和设备数限制;用专用邮箱和独立密码注册;订阅链接当作账号密码保管,不要分享。这五条能覆盖新手最常见的损失场景。',
  },
  {
    q: 'Clash、Shadowrocket 和 v2rayN 用户怎么选机场?',
    a: '关键是订阅格式与协议的兼容性。同一家服务给不同客户端的订阅链接往往不同,用错格式会导入后零节点。买之前先确认服务方是否提供你所用客户端的专用订阅,以及它支持的协议是否在你客户端的覆盖范围内。',
  },
  {
    q: 'ChatGPT 和 Netflix 用户怎么选机场?',
    a: '这两类需求看的不是速度而是出口 IP。AI 工具要求 IP 信誉良好且尽量固定,频繁换 IP 会触发验证甚至风控;流媒体要求落地 IP 未被平台识别,且片库地区符合预期。带宽在这两个场景里都不是瓶颈,IP 质量才是。',
  },
  {
    q: '月付、年付和按量计费哪个好?',
    a: '取决于你对这家服务的信心。没用过的一律月付;用满一到两个月确认稳定后转季付;只有运营时间长、口碑持续良好的服务才值得年付。用量小或作为备用时,按量计费的流量包避免了闲置浪费,但单价更高。',
  },
  {
    q: '机场推荐榜单是如何排序的?',
    a: '本站目前不发布名次榜。服务质量随时间波动明显,固定名次很快失真,而且容易被推广利益影响。我们改用服务档案加数据状态标识:每项信息标注核实到什么程度和核验日期,由你按自己的需求判断。榜单该怎么看,单独有一页说明。',
  },
  {
    q: '网站多久更新一次机场信息?',
    a: '服务档案在发现已知变动时更新并刷新核验日期;客户端教程在界面明显变化时重新检查;超过半年未更新的文章会自动显示时效提示。每篇内容都标注发布、更新和最后核验三个时间。',
  },
];

const jsonLd = [organizationSchema(), websiteSchema(), faqSchema(faq)!];
---

<BaseLayout
  title="2026 机场推荐:9 家实测数据、客户端教程与故障排查"
  description="2026 机场推荐:九家服务的第一方测速数据、套餐与线路档案,Clash 与 Shadowrocket 配置教程,以及节点超时、订阅失败等 16 类故障的完整排查流程。"
  path="/"
  jsonLd={jsonLd}
>
  <Hero title="2026 机场推荐指南：稳定机场、便宜机场与专线机场怎么选" />
  <section class="section home-search">
    <div class="container">
      <a class="home-search-box" href="/search/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <span>搜索文章、教程或故障关键词,例如「节点超时」…</span>
      </a>
    </div>
  </section>
  <QuickProblemFinder />
  <PromotedProviders providers={providerEntries} />
  <PicksGrid entries={pickEntries} alt={true} />
  <ScenarioGrid items={scenarioItems} />
  <TroubleshootingGrid items={troubleshootingCards} />
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">新手入门路径</h2>
      <p class="section-lead">
        第一次接触这类工具?按「懂概念 → 选服务 → 配客户端 → 会排查」四步走,半小时完成配置,少踩九成的坑。
      </p>
      <p><a class="btn btn-primary" href="/start/">进入新手入门</a></p>
    </div>
  </section>
  <ClientGuideGrid items={clientCards} />
  <FeaturedArticles
    items={chooseCards}
    title="服务选择参考"
    lead="不靠榜单靠判断:看懂参数、算清流量、选对周期。"
    alt={true}
  />
  <MethodologyPreview />
  <RiskAlerts />
  <LatestUpdates items={latest} />
  <section class="section section-alt">
    <div class="container">
      <FAQSection faq={faq} title="关于本站的常见问题" />
    </div>
  </section>
  <NewsletterPlaceholder />
</BaseLayout>

<style>
  .home-search {
    padding: var(--space-5) 0 0;
  }
  .home-search-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 40rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    background: var(--color-bg);
    font-size: var(--text-sm);
  }
  .home-search-box:hover {
    border-color: var(--color-brand);
    text-decoration: none;
    color: var(--color-brand);
  }
</style>

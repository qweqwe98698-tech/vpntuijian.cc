---
import SectionLayout from '@layouts/SectionLayout.astro';
import FAQSection from '@components/FAQSection.astro';
import ResponsiveTable from '@components/ResponsiveTable.astro';
import Checklist from '@components/Checklist.astro';
import WarningBox from '@components/WarningBox.astro';
import { faqSchema } from '@lib/schema';

// 承接问题库第 2 节「稳定机场推荐」问题簇
const extraFaq = [
  {
    q: '什么样的机场才算稳定?',
    a: '可操作的定义是:在你自己的网络环境下,连续一周的晚高峰时段仍能满足最低可用标准,出现故障时能在可接受时间内恢复,并且服务方会说明原因。不是「从不出问题」,而是「波动幅度可预期、恢复速度可接受」。',
  },
  {
    q: '机场节点多就一定稳定吗?',
    a: '没有必然关系。节点数量只说明可选项多,不说明每个节点的线路质量和带宽冗余。一家有 200 个节点但入口带宽饱和的服务,高峰期表现可能不如只有 30 个节点但做了扩容的服务。',
  },
  {
    q: '专线机场一定比普通机场稳定吗?',
    a: '通常波动更小,但不是绝对的。专线不与公网流量混跑,受拥堵影响小;但专线同样有带宽上限,超售一样会慢。专线降低的是波动幅度,不是消除拥挤的可能。',
  },
  {
    q: '老牌机场一定比新机场稳定吗?',
    a: '运营时间长能提高可信度,因为它已经经历过若干次线路调整和政策变化并存活下来。但这不是保证——运营多年后停止服务的情况同样存在,需要结合近期的公告频率和客服响应一起判断。',
  },
  {
    q: '机场速度快和稳定是一回事吗?',
    a: '不是。速度是峰值能力,稳定是这个能力随时间的波动幅度。一个峰值 200Mbps 但晚高峰掉到 5Mbps 的服务,不如峰值 50Mbps 但全天维持在 30Mbps 的服务好用。测速截图只反映某一瞬间。',
  },
  {
    q: '如何测试机场长连接稳定性?',
    a: '用实际的长连接场景来测,而不是看延迟数字:开一个视频会议或长时间的 SSH 会话,观察一小时内是否断开。也可以观察 AI 工具的长回复是否中途卡住。断连次数比平均延迟更能说明问题。',
  },
  {
    q: '如何测试机场晚高峰表现?',
    a: '在非高峰时段先记录一组基准数据(延迟、丢包、实际下载速度),再在 20:00 到 23:00 重复同样的测试,对比劣化幅度。单晚数据受偶然因素影响大,建议连续测三到五天看趋势。',
  },
  {
    q: '稳定机场为什么价格通常更高?',
    a: '稳定性的成本主要在带宽冗余和线路质量上——留出余量应对高峰、采购质量更好的线路,都会推高单位成本。低价服务通过提高共享比例压低价格,代价就是高峰期的确定性。',
  },
  {
    q: '稳定机场适合购买年付套餐吗?',
    a: '即使服务表现稳定,也建议先月付观察一到两个月,确认后再转季付,用满半年到一年再考虑年付。稳定性是运营状态的结果,而运营状态会变,年付承担的是这个变化的风险。',
  },
];

const faq = [
  {
    q: '有没有绝对稳定的机场?',
    a: '没有。线路故障、政策波动和高峰拥堵是这类服务的固有属性,任何宣称「永远稳定」「保证不断线」的宣传都不可信。能做到的是选择波动小、恢复快、沟通透明的服务,并自己准备备用方案。',
  },
  {
    q: '试用几天感觉很快,能代表长期稳定吗?',
    a: '不能。短期体验只能排除明显不合格的服务。稳定性要看晚高峰表现、跨月表现和故障后的恢复速度,建议先月付观察一个完整周期,重点关注 20:00 到 23:00 的表现。',
  },
  {
    q: '稳定和速度哪个更重要?',
    a: '取决于用途:视频会议和 AI 对话对延迟波动敏感,稳定优先;大文件下载对峰值带宽敏感,速度优先。多数人高估了自己对峰值速度的需求,低估了对稳定性的需求。',
  },
];

const allFaq = [...faq, ...extraFaq];
const jsonLd = [faqSchema(allFaq)!];
---

<SectionLayout
  title="稳定机场推荐:怎么判断一个机场是否真的稳定"
  description="把「稳定」拆成可验证的指标:晚高峰的延迟劣化幅度、丢包率、长连接是否中断、故障恢复速度与运营历史。给出一个月观察期的具体安排,以及为什么节点数量多不等于稳定。"
  path="/stable/"
  h1="稳定机场推荐与稳定性判断方法"
  lead="「稳定」是机场宣传里最泛滥也最难验证的词。这一页把稳定拆解成可以自己观察的具体指标,给出验证方法。"
  directAnswer="判断机场是否稳定,要把「稳定」拆成可验证的指标:晚高峰的延迟劣化幅度、丢包率、长连接是否频繁中断、故障后的修复速度。节点数量多、测速截图漂亮都不等于稳定。可靠做法是先月付一个月,在自己的网络环境下连续观察 20:00 到 23:00 的表现。"
  extraJsonLd={jsonLd}
>
  <section class="section">
    <h2>稳定性的四个可观察维度</h2>
    <ResponsiveTable label="稳定性判断维度">
      <table>
        <thead>
          <tr>
            <th scope="col">维度</th>
            <th scope="col">怎么观察</th>
            <th scope="col">合格线参考</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">晚高峰表现</th>
            <td>连续一周在 20:00–23:00 使用常用节点,记录延迟和卡顿</td>
            <td>延迟上浮但不断流,视频 1080p 不频繁缓冲</td>
          </tr>
          <tr>
            <th scope="row">故障恢复速度</th>
            <td>节点故障后多久修复、公告是否及时</td>
            <td>普通故障当天内响应,有明确公告渠道</td>
          </tr>
          <tr>
            <th scope="row">线路结构</th>
            <td>档案里的线路类型:专线占比、是否有备用中转</td>
            <td>核心节点为专线或优质中转,而非全直连</td>
          </tr>
          <tr>
            <th scope="row">运营历史</th>
            <td>运营时长、历史跑路记录、价格政策变化频率</td>
            <td>持续运营两年以上且无恶性事件记录</td>
          </tr>
        </tbody>
      </table>
    </ResponsiveTable>
    <p>
      线路类型对稳定性的影响详见
      <a href="/protocols/iepl-vs-iplc/">IEPL 与 IPLC 有什么区别</a>和
      <a href="/protocols/direct-relay-dedicated-lines/">直连、中转和专线怎么选</a>。
    </p>
  </section>

  <section class="section">
    <h2>一个月观察期怎么安排</h2>
    <Checklist
      items={[
        '第 1 周:日常使用,确认基础可用性和客户端兼容性',
        '第 2 周:固定在晚高峰测试常用场景,记录主观体验',
        '第 3 周:观察一次订阅更新和节点调整是否平滑',
        '第 4 周:检查客服响应速度,决定是否续费或换季付',
      ]}
    />
    <WarningBox title="常见误判">
      <p>
        用一次测速软件的峰值速度判断稳定性是最常见的错误。测速服务器往往被优化过,真实场景的持续吞吐和延迟波动才是稳定性的核心。晚高峰速度问题的具体判断方法见
        <a href="/troubleshooting/evening-peak-slow/">晚高峰延迟高和速度慢如何判断</a>。
      </p>
    </WarningBox>
  </section>

  <FAQSection faq={allFaq} />

  <section class="section">
    <h2>相关栏目</h2>
    <div class="grid grid-3">
      <a class="card" href="/directory/">
        <h3>服务导航</h3>
        <p>查看各服务档案中的线路类型与状态记录。</p>
      </a>
      <a class="card" href="/value/">
        <h3>性价比机场</h3>
        <p>预算优先时,稳定性上可以接受哪些妥协。</p>
      </a>
      <a class="card" href="/risk/">
        <h3>风险与避坑</h3>
        <p>「稳定」宣传背后的常见套路识别。</p>
      </a>
    </div>
  </section>
</SectionLayout>
